# Local secrets only — never commit backend/.env.
# Each new process loads this file and overrides stale OS/shell env vars.
# Restart the API server or script after editing .env (nothing is stored at OS level).

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/appdb
DATABASE_URL_SYNC=postgresql+psycopg://app_user:changeme@localhost:5432/appdb

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Use * for local dev (any frontend port/origin). Production: list explicit URLs only.
CORS_ALLOWED_ORIGINS=*

ENABLE_SCHEDULER=false
EMAIL_FEATURES_ENABLED=false
# SMTP_* settings are ignored while EMAIL_FEATURES_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Seed script (scripts/seed_phase1.py)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=Demo Agency

# Smoke test ephemeral users (scripts/smoke_test_full.py)
SMOKE_ADMIN_PASSWORD=
SMOKE_PORTAL_PASSWORD=
SMOKE_MEMBER_PASSWORD=

# Pytest fixture user passwords (tests/)
TEST_FIXTURE_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

RESEND_API_KEY=
SENTRY_DSN=

ASSETS_ROOT_PATH=\\192.168.0.10\Shared\agency-crm-assets
ASSETS_UPLOAD_TOKEN_EXPIRE_MINUTES=15

POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
